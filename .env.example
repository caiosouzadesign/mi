# Banco de dados (Turso/libSQL). Em desenvolvimento pode ser um arquivo local.
DATABASE_URL=file:local.db
# Em produção (Turso): libsql://seu-banco.turso.io
DATABASE_AUTH_TOKEN=

# Senha do painel do proprietário (/admin). Em produção: 12+ caracteres.
# Trocar esta senha desconecta todas as sessões abertas.
ADMIN_PASSWORD=troque-esta-senha

# Segredo para assinar a sessão do admin. Em produção: 32+ caracteres aleatórios
# (gere com: openssl rand -base64 32)
SESSION_SECRET=troque-por-um-texto-aleatorio-longo

# Segredo compartilhado com o Google Apps Script que lê o Gmail (32+ caracteres aleatórios)
INGEST_SECRET=troque-por-outro-texto-aleatorio-longo

# Senhas possíveis dos PDFs, separadas por vírgula (algumas distribuidoras protegem o PDF com parte do CPF)
PDF_PASSWORDS=

# Endereço público do site (usado nos links compartilhados). Na Vercel é detectado automaticamente.
APP_URL=

# ---------- Contrato e lembretes ----------
# Segredo da rotina diária (lembretes de fim de contrato). A Vercel envia sozinha
# no cron configurado em vercel.json; basta cadastrar a variável.
CRON_SECRET=

# E-mail opcional (https://resend.com): avisos de contrato também por e-mail
RESEND_API_KEY=
EMAIL_FROM=Contas do Imóvel <avisos@seu-dominio.com.br>

# ---------- Assinatura digital (ZapSign) ----------
ZAPSIGN_API_TOKEN=
# true para usar o ambiente de testes (sandbox.zapsign.com.br)
ZAPSIGN_SANDBOX=false
# Segredo na URL do webhook: https://SEU-SITE/api/webhooks/assinatura?secret=...
SIGNATURE_WEBHOOK_SECRET=
# Se preenchido, o proprietário também assina os documentos
OWNER_NAME=
OWNER_EMAIL=
OWNER_PHONE=
