# Banco de dados (Turso/libSQL). Em desenvolvimento pode ser um arquivo local.
DATABASE_URL=file:local.db
# Em produção (Turso): libsql://seu-banco.turso.io
DATABASE_AUTH_TOKEN=

# Senha do painel do proprietário (/admin)
ADMIN_PASSWORD=troque-esta-senha

# Segredo para assinar a sessão do admin (texto aleatório longo)
SESSION_SECRET=troque-por-um-texto-aleatorio-longo

# Segredo compartilhado com o Google Apps Script que lê o Gmail (texto aleatório longo)
INGEST_SECRET=troque-por-outro-texto-aleatorio-longo

# Senhas possíveis dos PDFs, separadas por vírgula (algumas distribuidoras protegem o PDF com parte do CPF)
PDF_PASSWORDS=

# Endereço público do site (usado nos links compartilhados). Na Vercel é detectado automaticamente.
APP_URL=
